# Create product — FORM-DATA (lihat ProductProxyHandler.create; wajib
# merchant_id & category_id valid di DB karena FK).
POST {{base}}/api/products
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary123

--boundary123
Content-Disposition: form-data; name="merchant_id"

1
--boundary123
Content-Disposition: form-data; name="category_id"

1
--boundary123
Content-Disposition: form-data; name="name"

Produk Baru
--boundary123
Content-Disposition: form-data; name="price"

150000
--boundary123
Content-Disposition: form-data; name="count_in_stock"

50
--boundary123
Content-Disposition: form-data; name="brand"

TestBrand
--boundary123
Content-Disposition: form-data; name="weight"

100
--boundary123--

PUT {{base}}/api/products/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Produk Updated", "price": 160000 }

