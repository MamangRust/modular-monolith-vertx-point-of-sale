# =============================================================================
# API CONTRACT — Point-of-Sale REST API Gateway
# =============================================================================
# Source of truth: apigateway/src/main/java/io/example/apigateway/routes/GatewayRoutes.java
# + GrpcGatewayUtils (envelope & error mapping). Diverifikasi 2026-08-07 (Fase 3).
#
# Format: VS Code "REST Client" / IntelliJ HTTP Client (.http).
# Base URL: http://localhost:5000 (di-proxy NGINX :80). Semua route /api/*
# dan /users*, /roles*, /transactions* dilindungi JWT — kecuali
# /api/chaos/* (control plane internal, tanpa JWT middleware).
#
# Envelope sukses (JSON protobuf, snake_case):
#   { "status": "success", "message": "...", "data": {...} }
#   List: { "status": "success", "message": "...", "data": [...],
#           "pagination": { "current_page", "page_size", "total_pages",
#                           "total_records" } }
#
# Envelope error (konsisten semua endpoint):
#   { "status": "error", "message": "...", "code": <int>,
#     "trace_id": "<uuid>" }        (code = HTTP status)
#
# Error mapping (GrpcGatewayUtils.handleError):
#   INVALID_ARGUMENT/FAILED_PRECONDITION → 400   NOT_FOUND → 404
#   ALREADY_EXISTS → 409   UNAUTHENTICATED → 401   PERMISSION_DENIED → 403
#   RESOURCE_EXHAUSTED → 429   UNAVAILABLE → 503   lain → 500
#
# Auth: token dari POST /login (JSON): { "email", "password" } →
#   { data: { "access_token", "refresh_token", ... } } → pakai
#   "Authorization: Bearer {{token}}".
#
# Catatan port gRPC internal (gap #7 CLOSED, semua 5005x/5006x):
#   auth 50051 · role 50052 · user 50053 · merchant 50054 · order 50055
#   product 50056 · order_item 50057 · transaction 50058 · cashier 50061
#   category 50062 · apigateway REST :5000 · email = Kafka consumer (tanpa gRPC)
# =============================================================================

@base = http://localhost:5000
@token = <isi_access_token_dari_login>

# ────────────────────────────────────────────────────────────────────────────
# 1. PUBLIC / AUTH
# ────────────────────────────────────────────────────────────────────────────

# Health check (publik)
GET {{base}}/health

### Register user baru (JSON)
POST {{base}}/register
Content-Type: application/json

{
  "firstname": "John",
  "lastname": "Doe",
  "email": "john@example.com",
  "password": "P@ssw0rd123!"
}

### Login (JSON) → { status, message, data: { access_token, refresh_token } }
POST {{base}}/login
Content-Type: application/json

{
  "email": "john@example.com",
  "password": "P@ssw0rd123!"
}

### Refresh token
POST {{base}}/refresh-token
Content-Type: application/json

{
  "refresh_token": "..."
}

### Get current user (JWT)
GET {{base}}/me
Authorization: Bearer {{token}}

### Logout (JWT)
GET {{base}}/logout
Authorization: Bearer {{token}}

