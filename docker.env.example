# =============================================================================
# Point of Sale — Environment Configuration Template
# =============================================================================
# Copy this file to docker.env and fill in your values.
#   cp docker.env.example docker.env
#
# For local development, the defaults below work out of the box.
# For production, CHANGE ALL SECRETS before deploying.
# =============================================================================

APP_ENV=docker

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_DRIVER=pgx
DB_HOST=pgbouncer
DB_HOST_MIGRATE=postgres
DB_PORT=5432
DB_USERNAME=DRAGON
DB_PASSWORD=DRAGON
DB_NAME=POINT_OF_SALE

DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# ── Redis Cluster ───────────────────────────────────────────────────────────
REDIS_HOST=redis-node-1
REDIS_PORT=6379
REDIS_PASSWORD=dragon_knight
REDIS_CLUSTER_ENABLED=true
REDIS_CLUSTER_ENDPOINTS=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379,redis-node-4:6379,redis-node-5:6379,redis-node-6:6379

# Per-service Redis DB indices
REDIS_HOST_APIGATEWAY=redis-node-1
REDIS_PORT_APIGATEWAY=6379
REDIS_PASSWORD_APIGATEWAY=dragon_knight
REDIS_DB_APIGATEWAY=0

REDIS_HOST_AUTH=redis-node-1
REDIS_PORT_AUTH=6379
REDIS_PASSWORD_AUTH=dragon_knight
REDIS_DB_AUTH=1

REDIS_HOST_ROLE=redis-node-1
REDIS_PORT_ROLE=6379
REDIS_PASSWORD_ROLE=dragon_knight
REDIS_DB_ROLE=2

REDIS_HOST_MERCHANT=redis-node-1
REDIS_PORT_MERCHANT=6379
REDIS_PASSWORD_MERCHANT=dragon_knight
REDIS_DB_MERCHANT=3

REDIS_HOST_TRANSACTION=redis-node-1
REDIS_PORT_TRANSACTION=6379
REDIS_PASSWORD_TRANSACTION=dragon_knight
REDIS_DB_TRANSACTION=4

REDIS_HOST_CASHIER=redis-node-1
REDIS_PORT_CASHIER=6379
REDIS_PASSWORD_CASHIER=dragon_knight
REDIS_DB_CASHIER=5

REDIS_HOST_CATEGORY=redis-node-1
REDIS_PORT_CATEGORY=6379
REDIS_PASSWORD_CATEGORY=dragon_knight
REDIS_DB_CATEGORY=6

REDIS_HOST_PRODUCT=redis-node-1
REDIS_PORT_PRODUCT=6379
REDIS_PASSWORD_PRODUCT=dragon_knight
REDIS_DB_PRODUCT=7

REDIS_HOST_ORDER=redis-node-1
REDIS_PORT_ORDER=6379
REDIS_PASSWORD_ORDER=dragon_knight
REDIS_DB_ORDER=8

REDIS_HOST_ORDERITEM=redis-node-1
REDIS_PORT_ORDERITEM=6379
REDIS_PASSWORD_ORDERITEM=dragon_knight
REDIS_DB_ORDERITEM=9

REDIS_HOST_USER=redis-node-1
REDIS_PORT_USER=6379
REDIS_PASSWORD_USER=dragon_knight
REDIS_DB_USER=10

# ── Application ─────────────────────────────────────────────────────────────
# Seeder (db-migration): true → insert roles ROLE_ADMIN/ROLE_CASHIER/ROLE_MERCHANT
# + admin user pre-verified (admin@example.com / Admin@123, bisa di-override via
# SEED_ADMIN_* env). Idempotent — aman dijalankan berulang.
DB_SEEDER=false
# ⚠️ Wajib SAMA di service auth (penandatangan) DAN apigateway (verifikator).
# Bedakan nilai → seluruh JWT ditolak (401 membingungkan).
SECRET_KEY=yantopedia

# ── Gateway Resilience (gap #25) ────────────────────────────────────────────
# Rate limiter per client IP (token bucket): RATE_LIMIT_PER_SECOND refill,
# RATE_LIMIT_BURST kapasitas burst. Request berlebih → 429 envelope.
RATE_LIMIT_PER_SECOND=100
RATE_LIMIT_BURST=200
DB_URL=postgres://DRAGON:DRAGON@postgres:5432/POINT_OF_SALE
KAFKA_BROKERS=kafka:9092
APP_LOGGER=production
OTEL_ENDPOINT=otel-collector:4317

# ── gRPC Endpoints ──────────────────────────────────────────────────────────
GRPC_AUTH_ADDR=auth:50051
GRPC_ROLE_ADDR=role:50052
GRPC_USER_ADDR=user:50053
GRPC_MERCHANT_ADDR=merchant:50054
GRPC_TRANSACTION_ADDR=transaction:50058
GRPC_CASHIER_ADDR=cashier:50061
GRPC_CATEGORY_ADDR=category:50062
GRPC_PRODUCT_ADDR=product:50056
GRPC_ORDER_ADDR=order:50055
GRPC_ORDER_ITEM_ADDR=order_item:50057

GRPC_AUTH_PORT=50051
GRPC_ROLE_PORT=50052
GRPC_USER_PORT=50053
GRPC_MERCHANT_PORT=50054
GRPC_TRANSACTION_PORT=50058
GRPC_CASHIER_PORT=50061
GRPC_CATEGORY_PORT=50062
GRPC_PRODUCT_PORT=50056
GRPC_ORDER_PORT=50055
GRPC_ORDER_ITEM_PORT=50057

# ── SMTP / Email Notifications ──────────────────────────────────────────────
SMTP_SERVER=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
