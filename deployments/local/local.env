# ============================================
# Local development env — Java services run on host
# Infra (postgres, redis, kafka) runs in docker
# ============================================

# --- Database ---
DB_DRIVER=pgx
DB_HOST=localhost
DB_HOST_MIGRATE=localhost
DB_PORT=5432
DB_USERNAME=DRAGON
DB_PASSWORD=DRAGON
DB_NAME=POINT_OF_SALE
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_SEEDER=true

# --- Redis (cluster via localhost, docker maps 6379) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dragon_knight
REDIS_CLUSTER_ENABLED=true
REDIS_CLUSTER_ENDPOINTS=localhost:6371,localhost:6372,localhost:6373,localhost:6374,localhost:6375,localhost:6376

# --- Per-service Redis ---
REDIS_HOST_AUTH=localhost
REDIS_PORT_AUTH=6379
REDIS_PASSWORD_AUTH=dragon_knight
REDIS_DB_AUTH=1

